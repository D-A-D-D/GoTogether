# Copy to .env and fill in. Never commit the real .env.

# Local via docker-compose.yml:
#   DATABASE_URL="postgresql://gotogether:gotogether@localhost:5432/gotogether?schema=public"
#   DATABASE_URL_DIRECT — same value, Postgres has no pooler to route around locally.
#
# Neon (or another host with a separate pooled/direct endpoint): DATABASE_URL
# is the pooled (PgBouncer) connection string for normal app traffic;
# DATABASE_URL_DIRECT is the direct connection Prisma's migration engine
# needs (PgBouncer's transaction-pooling mode doesn't support the prepared
# statements migrations rely on).
DATABASE_URL="postgresql://gotogether:gotogether@localhost:5432/gotogether?schema=public"
DATABASE_URL_DIRECT="postgresql://gotogether:gotogether@localhost:5432/gotogether?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-dev-only-too"
JWT_REFRESH_TTL="30d"

# OAuth — create these in the Google Cloud Console / Apple Developer portal.
# Auth still works without them (email/password), Google/Apple sign-in just
# won't be wired up until these are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_CALLBACK_URL="http://localhost:3001/auth/apple/callback"

PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Web Push (VAPID) — generate a real pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is not secret; it's handed to the browser so it can
# subscribe. VAPID_SUBJECT must be a mailto: or https: URL per the spec —
# push services use it to contact you if your server misbehaves.
VAPID_PUBLIC_KEY="change-me-dev-only"
VAPID_PRIVATE_KEY="change-me-dev-only"
VAPID_SUBJECT="mailto:admin@example.com"

# Email — password reset and address verification.
# EMAIL_PROVIDER=log (the default) prints each email, links included, to the API
# log: right for development, never for production. In production use `resend`
# (https://resend.com): create an API key, and verify the domain EMAIL_FROM is on.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="GoTogether <no-reply@your-domain.example>"

# Production only: how many reverse proxies sit in front of the API (e.g. 1 on
# most hosting platforms; 0 if none). Rate limits are per client address, and
# this is how the API knows which header to trust for it.
TRUST_PROXY=
