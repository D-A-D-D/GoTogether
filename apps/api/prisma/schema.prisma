// GoTogether — Phase 0 schema (docs/ROADMAP.md, docs/BLUEPRINT.md §03)
// Single-market, single-currency for now (confirmed open decision #5) —
// budgetMin/budgetMax are plain integers in one implied currency; revisit
// with a currency column if/when multi-currency scope is picked up.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app's normal query traffic (Neon's PgBouncer
  // endpoint scales better under many short-lived connections).
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for migrations — DDL and Prisma's
  // migration engine need prepared-statement support that PgBouncer's
  // transaction-pooling mode doesn't provide.
  directUrl = env("DATABASE_URL_DIRECT")
}

// ---------- Identity & trust ----------

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String? // null for OAuth-only accounts

  name    String
  bio     String?
  // Home location: only city/region ever leaves the server (BLUEPRINT §09).
  // homeLat/homeLng are the precise geocode used server-side for the
  // matching engine's location factor — never select these into a
  // client-facing DTO.
  homeCity   String?
  homeRegion String?
  homeLat    Float?
  homeLng    Float?

  trustScore       Int              @default(50)
  verificationTier VerificationTier @default(EMAIL)
  accountStatus    AccountStatus    @default(ACTIVE)
  // Never settable through the app — only by an operator with database access
  // (apps/api/scripts/set-role.ts). A moderator can suspend people, so the way
  // to become one shouldn't be reachable from a request.
  role             UserRole         @default(USER)
  // Set when the person deleted their account; see AccountStatus.DELETED.
  deletedAt        DateTime?
  // When they proved they own the address, by following the link we emailed (or by
  // signing in with Google, which has already verified it). Null until then.
  emailVerifiedAt  DateTime?

  preferenceTags Tag[] @relation("UserPreferenceTags")

  hostedTrips      Trip[]             @relation("TripHost")
  memberships      TripMembership[]
  trustScoreEvents TrustScoreEvent[]  @relation("TrustScoreEventUser")
  refreshTokens    RefreshToken[]
  oauthAccounts    OAuthAccount[]
  reportsFiled     Report[]           @relation("ReportReporter")
  reportsReceived  Report[]           @relation("ReportReported")
  blocksInitiated  Block[]            @relation("BlockBlocker")
  blocksReceived   Block[]            @relation("BlockBlocked")
  sentMessages     Message[]
  expensesPaid     Expense[]          @relation("ExpensePaidBy")
  expensesLogged   Expense[]          @relation("ExpenseCreatedBy")
  expenseSplits    ExpenseSplit[]     @relation("ExpenseSplitUser")
  reviewsGiven     Review[]           @relation("ReviewReviewer")
  reviewsReceived  Review[]           @relation("ReviewReviewee")
  pushSubscriptions PushSubscription[]
  emailTokens       EmailToken[]
  reportsReviewed     Report[]           @relation("ReportReviewer")
  moderationsMade     ModerationAction[] @relation("ModerationActor")
  moderationsReceived ModerationAction[] @relation("ModerationTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trustScore])
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationTier {
  EMAIL
  PHONE
  ID
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  // The person deleted their own account. The row stays (messages, expenses and
  // reviews in other people's trips point at it) but every identifying field is
  // scrubbed and it can never be signed in to or reinstated (BLUEPRINT section 09).
  DELETED
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String // "google" | "apple"
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

// Refresh tokens are stored hashed and rotated on use — never the raw token.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Controlled tag vocabulary — NOT free text. `category` gates whether a
// tag is eligible as a private Trip.excludeTags filter (BLUEPRINT §01):
// only STYLE tags should ever be allowed there at the application layer.
model Tag {
  id       String      @id @default(cuid())
  name     String      @unique
  category TagCategory
  isActive Boolean     @default(true)

  usersWithPreference User[] @relation("UserPreferenceTags")
  tripsIncluding      Trip[] @relation("TripIncludeTags")
  tripsExcluding      Trip[] @relation("TripExcludeTags")

  createdAt DateTime @default(now())
}

enum TagCategory {
  STYLE // trip-style/logistics — safe as a private exclude filter
  IDENTITY // who someone is — include-only, surfaced via Trip.tripType, never a silent exclude
  DIETARY
  SAFETY
}

// Append-only audit trail behind every trust-score change (BLUEPRINT §05).
model TrustScoreEvent {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("TrustScoreEventUser", fields: [userId], references: [id], onDelete: Cascade)
  delta          Int
  reason         String
  resultingScore Int
  sourceReviewId String?
  // Plain column, no FK relation (same precedent as sourceReviewId) — lets
  // the per-trip anti-gaming cap sum prior deltas for (userId, tripId)
  // without needing a formal Trip relation here.
  tripId         String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([tripId, userId])
}

// ---------- Trips & membership ----------

model Trip {
  id          String  @id @default(cuid())
  hostId      String
  host        User    @relation("TripHost", fields: [hostId], references: [id])
  title       String
  description String?
  destination String

  startDate     DateTime
  endDate       DateTime
  flexibleDates Boolean  @default(false)

  // Single currency for now — see file header note.
  budgetMin Int
  budgetMax Int
  capacity  Int

  // Up to 3, enforced at the application layer (Prisma can't cap list length).
  includeTags Tag[] @relation("TripIncludeTags")
  // Private — must never appear in a DTO reachable by a non-host user.
  // Application layer restricts this to TagCategory.STYLE only (BLUEPRINT §01).
  excludeTags Tag[] @relation("TripExcludeTags")

  // Visible, explicit alternative to identity-based exclusion (BLUEPRINT §01)
  tripType String?

  status     TripStatus     @default(DRAFT)
  visibility TripVisibility @default(PUBLIC)

  coverPhotoUrl String?

  memberships TripMembership[]
  chatRoom    ChatRoom?
  expenses    Expense[]
  reviews     Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startDate])
}

enum TripStatus {
  DRAFT
  OPEN
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum TripVisibility {
  PUBLIC
  UNLISTED
}

// The overlap-prevention rule (BLUEPRINT §03) can't be expressed in the
// Prisma schema — it needs a Postgres GIST EXCLUDE constraint. That's added
// via raw SQL in prisma/migrations/<ts>_trip_membership_overlap/migration.sql
// once the first migration runs against a real database. See that file for
// the exact constraint.
model TripMembership {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   MembershipRole   @default(MEMBER)
  status MembershipStatus @default(REQUESTED)

  requestedAt DateTime  @default(now())
  respondedAt DateTime?
  leftAt      DateTime?

  // Mirrors the parent Trip's [startDate, endDate) range; kept in sync by a
  // DB trigger (see prisma/migrations/20260902094145_trip_membership_overlap)
  // so the GIST EXCLUDE constraint on this table can compare across rows
  // without a join. `Unsupported` because Prisma Client can't query range
  // types directly — writes happen via the trigger, not the ORM.
  period Unsupported("daterange")?

  @@unique([tripId, userId])
  @@index([userId, status])
}

enum MembershipRole {
  HOST
  MEMBER
}

enum MembershipStatus {
  REQUESTED
  APPROVED
  REJECTED
  LEFT
  REMOVED
}

// ---------- Chat ----------

// One room per trip, created alongside the trip itself (BLUEPRINT §06) —
// the host's own membership is auto-approved at creation, so "created on
// first approval" and "created with the trip" are the same moment here.
model ChatRoom {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id       String   @id @default(cuid())
  roomId   String
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId String
  sender   User     @relation(fields: [senderId], references: [id])
  content  String

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// ---------- Expenses ----------

// A ledger, not a payment rail (BLUEPRINT §06) — nothing here ever moves
// money. `amount` is a plain integer in the trip's one implied currency,
// same convention as Trip.budgetMin/Max.
model Expense {
  id          String @id @default(cuid())
  tripId      String
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidById    String
  paidBy      User   @relation("ExpensePaidBy", fields: [paidById], references: [id])
  // Who entered it, which may not be who paid (you can log "Bob paid"). Together
  // with the payer, these are the two people who may edit or delete it. Null on
  // expenses logged before this column existed: only their payer can change them.
  createdById String?
  createdBy   User?  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  description String
  amount      Int
  category    String?

  splits    ExpenseSplit[]
  createdAt DateTime       @default(now())

  @@index([tripId, createdAt])
}

// One row per person who owes a share of an Expense — including the payer
// themselves, so splits always sum to the expense's full amount and a
// payer's own share nets to zero against what they fronted.
model ExpenseSplit {
  id        String    @id @default(cuid())
  expenseId String
  expense   Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("ExpenseSplitUser", fields: [userId], references: [id])
  amount    Int
  // Manual "mark as paid" (BLUEPRINT §06) — either side of the debt can set
  // this; see docs/IDEAS.md for the two-step-confirm version this skips for v1.
  settled   Boolean   @default(false)
  settledAt DateTime?

  @@unique([expenseId, userId])
}

// ---------- Reviews & trust ----------

// One row per (trip, reviewer, reviewee) pair, only submittable once the
// trip is COMPLETED (BLUEPRINT §05). `processedAt` marks when the
// trust-score delta was actually applied — not at submission, but once
// the blind window resolves (both sides have reviewed each other, or 14
// days pass), so neither the score movement nor the content leaks early
// and lets one side anchor or retaliate against the other.
model Review {
  id         String @id @default(cuid())
  tripId     String
  trip       Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User   @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User   @relation("ReviewReviewee", fields: [revieweeId], references: [id])

  reliability   Int
  friendliness  Int
  communication Int
  cleanliness   Int
  comment       String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([tripId, reviewerId, revieweeId])
  @@index([tripId])
  @@index([revieweeId])
}

// ---------- Notifications ----------

// One row per browser/device a user has enabled push on (Web Push has no
// concept of "one subscription per user" — each browser install gets its
// own endpoint+keys). `endpoint` alone is unique across all users since
// it's assigned by the browser's push service.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Safety ----------

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedId String
  reported   User         @relation("ReportReported", fields: [reportedId], references: [id])
  tripId     String?
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  // Set when a moderator moves the report out of OPEN.
  reviewedById String?
  reviewedBy   User?     @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  // The moderator's note on how it was resolved. Required to close a report.
  resolution   String?

  @@index([reportedId, status])
  @@index([status, createdAt])
  // The per-reporter daily rate limit counts a reporter's recent reports.
  @@index([reporterId, createdAt])
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

// Append-only audit trail of every change a moderator makes to an account's
// status (BLUEPRINT §10: "audit trail matters for a trust-scored marketplace").
// Rows are never updated or deleted by the app.
model ModerationAction {
  id         String        @id @default(cuid())
  actorId    String
  actor      User          @relation("ModerationActor", fields: [actorId], references: [id])
  targetId   String
  target     User          @relation("ModerationTarget", fields: [targetId], references: [id])
  fromStatus AccountStatus
  toStatus   AccountStatus
  reason     String
  // The report this action closed, when it came from one.
  reportId   String?
  createdAt  DateTime      @default(now())

  @@index([targetId, createdAt])
}

// Symmetric hide — application layer must check both directions.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  // The unique index covers lookups by blocker; blocks are symmetric, so
  // "who has blocked me" is looked up by blocked user on every request that
  // filters on them.
  @@index([blockedId])
}

enum EmailTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// A single-use link sent by email: to reset a password, or to verify an address.
/// Only a hash is stored, so reading the table can't produce a working link.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}
